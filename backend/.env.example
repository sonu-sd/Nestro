# Local backend configuration. Copy to .env and replace every placeholder.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nestro
CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret
SECRET_KEY=replace-with-a-long-random-encryption-key
EMAIL_USER=your-gmail-address@example.com
EMAIL_PASS=your-gmail-app-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
