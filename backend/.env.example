# Local backend configuration. Copy to .env and replace every placeholder.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nestro
CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret
BREVO_API_KEY=your-brevo-transactional-api-key
BREVO_SENDER_EMAIL=verified-sender@your-domain.example
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Set NODE_ENV=production on Render. Vercel proxies /api for same-origin cookies.
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
OTP_TTL_MINUTES=10
RAZORPAY_KEY_ID=rzp_test_replace-with-your-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
